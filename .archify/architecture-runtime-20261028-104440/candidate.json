  "cards": [
    {
      "dot": "emerald", "title": "Primary path",
      "items": [
        "Browser loads the UI shell from Next.js, then calls /api/* on the same origin",
        "Caddy proxies /api/* to blastjax-api:8000 and everything else to blastjax-web:3000",
        "Routers read Redis first, fall back to Neon SQL, then fill the cache",
        "Successful POST/PUT/PATCH/DELETE invalidate the route's cache namespaces"
      ]
    },
    {
      "dot": "rose", "title": "Trust boundaries",
      "items": [
        "Internet to EC2: only Caddy publishes :80/:443 and terminates TLS",
        "api and web publish no host ports; Redis binds 127.0.0.1 only",
        "Auth is opt-in: open until the first user exists, then gated routes need a Bearer session",
        "/api/auth/* and /api/health skip the gate; only SHA-256(token) is stored in Neon",
        "Login lockout keys on request.client.host, which behind Caddy is the proxy's IP",
        "BUDGET_DISABLE_AUTH=1 is set only by the local compose override"
      ]
    },
    {
      "dot": "cyan", "title": "Data and cache",
      "items": [
        "Neon pool keeps 6, max 10, with a SELECT 1 probe after 20 s idle",
        "API refuses to start if expected tables are missing",
        "Redis is optional: the API runs uncached if PING fails; the 1-day TTL is a backstop",
        "Session lookups are cached 5 min in Redis; the cache is flushed on API start and on deploy"
      ]
    },
    {
      "dot": "violet", "title": "In-process work",
      "items": [
        "Bill extraction: pypdf for text PDFs, a Tesseract subprocess for photos, no AI",
        "Uploads capped at 10 MB and checked by magic bytes (PDF, PNG, JPEG)",
        "Payslip parsing and the Mosaic and Mambo puzzle solvers run inside the API"
      ]
    },
    {
      "dot": "amber", "title": "Outbound calls",
      "items": [
        "PCSO: curl_cffi Chrome impersonation, 15-min reuse window, backoff up to 6 h; failure returns 502",
        "Maps: https Google hosts only, 6 s timeout, 64 KB read; failures return empty fields"
      ]
    },
    {
      "dot": "slate", "title": "Deploy (not runtime)",
      "items": [
        "Push to main: GitHub Actions builds api and web images to GHCR",
        "AWS SSM on EC2: git pull, migration scripts, compose up --wait, Redis flush",
        "Installs this site into the shared edge Caddy, which also serves two other sites",
        "NEXT_PUBLIC_API_URL is baked into the web image at build time"
      ]
    }
  ]
