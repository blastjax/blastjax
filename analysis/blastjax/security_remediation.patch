+def require_settings_access(request: Request) -> None:
+    """The server's copy of the web's isPageAllowed("/settings"): managing users is for whoever may open Settings."""
+    if not login_required():
+        return
+    user_id = session_user_id(_bearer_token(request))
+    user = get_app_user_by_id(user_id) if user_id else None
+    if user is None:
         raise HTTPException(status_code=401, detail="Login required.")
+    pages = user["allowed_pages"]
+    if not (user["is_superuser"] or pages is None or "/settings" in pages):
+        raise HTTPException(status_code=403, detail="You don't have access to Settings.")
 
 
