# SEC-002 / SEC-003: check_settings_access, a runnable check for both rules (python backend/test_core.py).
diff --git a/backend/test_core.py b/backend/test_core.py
index 39e0f1b..3e1fe55 100644
--- a/backend/test_core.py
+++ b/backend/test_core.py
@@ -210,6 +210,59 @@ def check_sessions() -> None:
         vars(security).update(saved)
 
 
+def check_settings_access() -> None:
+    from fastapi import HTTPException
+    from starlette.requests import Request
+
+    from app import deps
+    from app.routers import user as users_api
+
+    def status(call) -> int:
+        try:
+            call()
+        except HTTPException as exc:
+            return exc.status_code
+        return 200
+
+    def settings(token: str) -> int:
+        scope = {"type": "http", "headers": [(b"authorization", f"Bearer {token}".encode())]}
+        return status(lambda: deps.require_settings_access(Request(scope)))
+
+    people = {
+        "super": {"is_superuser": True, "allowed_pages": ["/calendar"]},
+        "unrestricted": {"is_superuser": False, "allowed_pages": None},
+        "settings": {"is_superuser": False, "allowed_pages": ["/settings"]},
+        "calendar": {"is_superuser": False, "allowed_pages": ["/calendar"]},
+        "nothing": {"is_superuser": False, "allowed_pages": []},
+    }
+    saved = {k: vars(deps)[k] for k in ("login_required", "session_user_id", "get_app_user_by_id")}
+    saved_list = users_api.list_app_users
+    try:
+        deps.login_required = lambda: True
+        deps.session_user_id = lambda token: token or None
+        deps.get_app_user_by_id = people.get
+        assert [settings(t) for t in ("super", "unrestricted", "settings")] == [200, 200, 200]
+        assert settings("calendar") == 403 and settings("nothing") == 403, "a user without Settings reached user admin"
+        assert settings("") == 401 and settings("deleted") == 401
+        deps.login_required = lambda: False
+        assert settings("") == 200, "first-user setup needs a login"
+        last, other = uuid.uuid4(), uuid.uuid4()
+        users_api.list_app_users = lambda: [{"id": last}]
+        assert status(lambda: users_api.users_remove(last)) == 409, "deleted the last user"
+        saved_delete = users_api.delete_app_user
+        try:
+            users_api.delete_app_user = lambda user_id: False
+            assert status(lambda: users_api.users_remove(other)) == 404, "an unknown id must stay a 404"
+            users_api.list_app_users = lambda: [{"id": last}, {"id": other}]
+            users_api.delete_app_user = lambda user_id: True
+            assert status(lambda: users_api.users_remove(last)) == 200, "blocked deleting a user who is not the last"
+        finally:
+            users_api.delete_app_user = saved_delete
+    finally:
+        vars(deps).update(saved)
+        users_api.list_app_users = saved_list
+
+
 def check_passkey_ceremony() -> None:
     import hashlib
     import json

