# Copy to .env and adjust. Variables are read when the backend loads `db.py`.

# Required for the API: SQLite file or PostgreSQL. Excel is only used for import/upload.
# Relative SQLite paths are resolved from the project root (parent of backend/).
DATABASE_URL=sqlite:///./data/budget.sqlite
# Docker Compose `db` service (host port 5433 → container 5432; see docker-compose.yml):
# DATABASE_URL=postgresql://budgetapp:budgetapp@127.0.0.1:5433/budgetapp

# Alternative for PostgreSQL: omit DATABASE_URL and set (password optional; DB_PORT defaults to 5432):
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=budgetapp
# DB_PASSWORD=budgetapp
# DB_NAME=budgetapp

# When set, the API creates only ``payslip``, ``installment``, and ``installment_line`` tables
# and registers only health + payslip + installment routes (no workbook/upload/catalog, etc.).
# Existing databases keep other tables on disk but those routes stay unregistered.
# BUDGET_DB_MINIMAL_SCHEMA=1

# BUDGET_EXCEL_PATH=./2026-03-25.xlsx
# BUDGET_SEED_EXCEL=1

# Optional SQLite tuning (see _configure_sqlite_connection in backend/db.py)
# BUDGET_SQLITE_CACHE_KB=65536
# BUDGET_SQLITE_MMAP_MB=128
# Journal mode: wal, delete, memory, … (optional; Docker Compose uses a /tmp working copy by default.)
# BUDGET_SQLITE_JOURNAL_MODE=wal
# Docker: copy DB to /tmp for the process lifetime, sync back on shutdown (see docker/README.md).
# BUDGET_SQLITE_WORKING_COPY=1
# BUDGET_SQLITE_WORKING_COPY_PATH=/tmp/budget.sqlite.working

# Docker Compose (optional): compose sets DATABASE_URL in the api service; for `web` rebuilds you can set:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# BUDGET_CORS_ORIGINS=https://your-ui.example

# --- Next.js (`web/`, baked in at `next build`) ---
# GitHub Pages + sql.js: load `public/budget.sqlite` in the browser (installments/payslip APIs only).
# NEXT_PUBLIC_USE_WASM_SQLITE=1
# Optional override for the seed file URL (default: `{basePath}/budget.sqlite`).
# NEXT_PUBLIC_WASM_SQLITE_URL=/myrepo/budget.sqlite
