# Copy to `.env` in the project root. The backend loads this when `db.py` is imported.

# Required: the Neon Postgres database the API reads and writes.
# Use the POOLED endpoint (the host containing `-pooler`) — the API opens many
# short-lived connections. DATABASE_URL_UNPOOLED is read only as a fallback and
# is the endpoint to use for DDL and bulk loads.
#
# Locally this normally lives in `.env.local` (gitignored) rather than here, and
# `.env.local` is read last but never overrides a variable already set in the
# environment — so the value docker-compose injects always wins in a container.
# Never commit a real URL: it embeds the database password.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Redis cache (optional). Defaults to localhost:6379 for a bare `uvicorn` run
# (rewritten to the 'redis' compose service automatically if run inside a
# container without this set). docker-compose.yml defaults it to
# redis://redis:6379 for the api container regardless — only set this to
# point at a different Redis.
# REDIS_URL=redis://localhost:6379
# Cache entry lifetime in seconds (default 86400 — a day). This is a backstop,
# not the correctness mechanism: every write invalidates the cache namespaces
# it affects, so an entry is dropped as soon as its data changes. Lowering it
# does not make the app fresher, it only sends more reads to Neon.
# REDIS_CACHE_TTL=86400

# Postgres connection pool (optional). BUDGET_DB_POOL_KEEP is how many
# connections stay pooled between requests — sized to a page load's fan-out so
# repeat visits don't pay for fresh TLS handshakes to Neon. BUDGET_DB_POOL_MAX
# caps concurrent use. BUDGET_DB_PROBE_AFTER_SECONDS is how long a pooled
# connection may sit idle before it costs a `SELECT 1` liveness check on
# checkout; below that it is trusted, which is what keeps a burst of requests
# from probing once each. See the round-trips note at the top of backend/db.py.
# BUDGET_DB_POOL_KEEP=6
# BUDGET_DB_POOL_MAX=10
# BUDGET_DB_PROBE_AFTER_SECONDS=20

# CORS (optional). Defaults include localhost dev servers.
# BUDGET_CORS_ORIGINS=https://your-ui.example

# Login (opt-in, no env var needed). All API routes except /api/health and
# /api/auth/* require a logged-in session once at least one user has been
# added via Settings → Users in the web app — nothing to configure here.
# How long a session stays valid server-side, in seconds. The browser
# forgets its session token (and re-prompts for login) on every restart
# regardless — this is just a server-side safety cap. Default 12h.
# BUDGET_SESSION_TTL_SECONDS=43200

# Next.js (`web/` build-time)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional base path for static export (`STATIC_EXPORT=1`): NEXT_PUBLIC_BASE_PATH=myapp

# Host port docker-compose publishes the web container on (container always
# listens on 3000). Defaults to 3000; set to 80 for a plain-HTTP production
# deployment (e.g. EC2) so the site is reachable without a port number.
# WEB_PORT=80

# uid:gid the api container runs as (default 1000:1000, matching the image's
# non-root user and the default `ubuntu` user on EC2). Only set these if the
# bind-mounted ./data directory is owned by a different user and the API logs
# permission errors writing to it. API_UID=0 restores running as root.
# API_UID=1000
# API_GID=1000
