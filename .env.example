# Copy to `.env` in the project root. The backend loads this when `db.py` is imported.

# Required: PostgreSQL URL (must start with postgresql:// or postgres://).

# Default: Postgres from `docker compose` published on the host at port 5433. Use this
# for local `uvicorn` and for Docker Compose — inside the API container, `127.0.0.1` /
# `localhost` are rewritten to hostname `db` port `5432` automatically.
DATABASE_URL=postgresql://postgres:blast@127.0.0.1:5433/budgetapp

# Neon / other remote hosts: paste the URL as-is (no rewrite). Password special chars
# must be URL-encoded. The backend adds sslmode=require when the host contains neon.tech.

# Alternative: omit DATABASE_URL and set (DB_PORT defaults to 5432):
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=blast
# DB_NAME=budgetapp
#
# When DB_HOST and DB_NAME are both set, that URL is preferred over DATABASE_URL so a
# leftover machine-level DATABASE_URL does not override Neon credentials from this file.

# Redis cache (optional). Defaults to localhost:6379 when unset.
# Inside Docker Compose, localhost is automatically rewritten to the 'redis' service.
# REDIS_URL=redis://localhost:6379
# REDIS_CACHE_TTL=300

# CORS (optional). Defaults include localhost dev servers.
# BUDGET_CORS_ORIGINS=https://your-ui.example

# Next.js (`web/` build-time)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional base path for static export (`STATIC_EXPORT=1`): NEXT_PUBLIC_BASE_PATH=myapp
